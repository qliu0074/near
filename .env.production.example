# Copy to .env.production. Do not reuse development secrets.
DOMAIN=near.example.com
ACME_EMAIL=operator@example.com
# Use independent random hex values (at least 32 bytes); hex is URL-safe.
POSTGRES_PASSWORD=
ELASTIC_PASSWORD=
AUTH_SECRET=
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMS=1024
TOKEN_LIMIT=100000
SITE_TOKEN_LIMIT=1000000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Per API process; active streams hold a slot until closed.
MAX_CONCURRENT_REQUESTS=32
STREAM_TIMEOUT_SECONDS=120
PROVIDER_TIMEOUT_SECONDS=45

# Hybrid retrieval. Rerank uses a full native DashScope endpoint, not QWEN_BASE_URL.
# RERANK_API_KEY falls back to QWEN_API_KEY; use a region-matching key.
BM25_CANDIDATES=20
KNN_CANDIDATES=20
KNN_NUM_CANDIDATES=100
FUSION_CANDIDATES=40
MEMORY_LIMIT=5
RERANK_ENABLED=false
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=gte-rerank-v2
RERANK_CANDIDATES=20
RERANK_TIMEOUT_SECONDS=10
