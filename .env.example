# Local secrets only. Never place credentials in NEXT_PUBLIC_* variables.
AI_PROVIDER=mock
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMS=1024
PORTRAIT_API_KEY=
# Lifetime aggregate token admission limits, not currency or monthly quotas.
TOKEN_LIMIT=100000
SITE_TOKEN_LIMIT=1000000
MAX_CONCURRENT_REQUESTS=32
STREAM_TIMEOUT_SECONDS=120
PROVIDER_TIMEOUT_SECONDS=45
# development returns a visible local test code; smtp sends actual email.
EMAIL_MODE=development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
AUTH_SECRET=
# Compose supplies PostgreSQL, Elasticsearch, Redis and AUTO_SCHEMA=false.
# For standalone processes, set these separately when needed:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/near
# ELASTICSEARCH_URL=https://HOST:9200
# ELASTICSEARCH_API_KEY=
# REDIS_URL=redis://HOST:6379/0
# AUTO_SCHEMA=false
# APP_ENV=production
# WEB_ORIGIN=https://YOUR_DOMAIN
